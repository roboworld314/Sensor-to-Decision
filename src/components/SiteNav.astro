---
import { links } from '../data/paper';

const items = [
  { href: '#demo', label: 'Demo' },
  { href: '#problem', label: 'Problem' },
  { href: '#method', label: 'Method' },
  { href: '#results', label: 'Results' },
  { href: '#deployment', label: 'Deployment' },
];
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top">SenseGuard</a>
    <nav aria-label="Sections">
      <ul>
        {items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>
    <a class="nav-appendix" href={links.appendix} target="_blank" rel="noopener">Appendix</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(243, 245, 247, 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 60px;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover {
    background: var(--rule-soft);
    color: var(--ink);
  }

  .nav-appendix {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-appendix:hover {
    background: var(--ink);
    color: #fff;
  }

  @media (max-width: 820px) {
    nav {
      display: none;
    }

    .nav-appendix {
      margin-left: auto;
    }
  }
</style>
