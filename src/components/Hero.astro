---
import FreshnessStrip from './FreshnessStrip.astro';
import { links } from '../data/paper';
import { asset } from '../lib/asset';
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1>
        <span class="hero-name">SenseGuard</span>
        <span class="hero-title">Sensor-to-Decision Adaptation and Learning for Reliable Agentic Robots</span>
      </h1>
      <p class="hero-lede">
        A robot can run an accurate detector at low per-frame latency and still act on the past. SenseGuard keeps the
        evidence behind each decision fresh: online, it drops low-value camera and LiDAR data before it clogs the
        pipeline; offline, it keeps the moments where perception failed so retraining targets them.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#demo">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l10.5-6.5z" /></svg>
          Watch the demo
        </a>
        <a class="btn" href={links.appendix} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
            ><path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z" /><path
              d="M14 3v5h5M8.5 13h7M8.5 16.5h7"></path></svg
          >
          Appendix
        </a>
      </div>
      <p class="hero-note">
        Anonymous authors. Demo and supplementary material for a paper under review; code and data will be released
        after review.
      </p>
    </div>

    <figure class="hero-photo">
      <img
        src={asset('images/robot-brick-path.jpg')}
        width="1400"
        height="1050"
        alt="The RovaX robotic vehicle, carrying a roof-mounted LiDAR and a stereo camera, faces the camera on a brick path. Metal bars lie across the path in front of it."
        fetchpriority="high"
      />
      <figcaption class="caption">RovaX test vehicle. Metal bars across the brick path shake the sensors as it drives over them.</figcaption>
    </figure>
  </div>

  <div class="wrap hero-strip">
    <FreshnessStrip />
  </div>
</section>

<style>
  .hero {
    padding: clamp(32px, 4.5vw, 64px) 0 var(--section-space);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
  }

  h1 {
    display: grid;
    gap: 1rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4.25rem, 11.5vw, 9.25rem);
    line-height: 0.82;
    letter-spacing: -0.025em;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 2.9vw, 2.35rem);
    line-height: 1.08;
    color: var(--ink-2);
    max-width: 22em;
  }

  .hero-lede {
    margin-top: 1.4rem;
    max-width: 38rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .hero-note {
    margin-top: 1rem;
    max-width: 38rem;
    font-size: 0.9375rem;
    color: var(--ink-3);
  }

  .hero-photo img {
    width: 100%;
    aspect-ratio: 4 / 3.2;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius);
  }

  .hero-strip {
    margin-top: clamp(40px, 4.5vw, 64px);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-photo {
      max-width: 560px;
    }

    .hero-photo img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
