---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import Demo from '../components/Demo.astro';
import Problem from '../components/Problem.astro';
import Method from '../components/Method.astro';
import Results from '../components/Results.astro';
import Deployment from '../components/Deployment.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout
  title="SenseGuard: Sensor-to-Decision Adaptation and Learning for Reliable Agentic Robots"
  description="Demo and results for SenseGuard, which keeps robot perception anchored to fresh sensor evidence by triaging camera and LiDAR frames online and retaining failure episodes for targeted retraining."
>
  <SiteNav />
  <main>
    <Hero />
    <Demo />
    <Problem />
    <Method />
    <Results />
    <Deployment />
  </main>
  <SiteFooter />
</Layout>
